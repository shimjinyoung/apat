# 실제 값은 .env 파일에 넣으세요 (커밋되지 않음, .claude 훅이 .env 직접 수정을 막습니다).
# 아래 두 키는 본인이 직접 회원가입해서 발급받아야 합니다 (Claude가 대신 가입 불가).

# 공공데이터포털(data.go.kr) > "국토교통부_아파트매매 실거래 상세 자료" 활용신청 후 발급
MOLIT_SERVICE_KEY=

# KOSIS 국가통계포털(kosis.kr/openapi) 회원가입 > Open API 활용신청 후 마이페이지에서 확인
KOSIS_API_KEY=

# 한국은행 ECOS(ecos.bok.or.kr/api) 회원가입 후 발급
ECOS_API_KEY=

# 한국주택금융공사 HOUSTAT(houstat.hf.go.kr) 로그인 후 Open API 인증키 발급 메뉴에서 확인
HF_API_KEY=
